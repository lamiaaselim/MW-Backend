doctype html
html
  head
    title= title
    script(src="https://cdn.tailwindcss.com")
  body.bg-gray-200.min-h-screen.p-6

    h1.text-2xl.font-bold.text-center.mb-6 SCHOOL MANAGEMENT SYSTEM

    .overflow-x-auto
      table.w-full.border-collapse.bg-gray-800.text-gray-200.rounded-lg.overflow-hidden
        thead.bg-gray-900
          tr
            th.px-6.py-4.text-left ID
            th.px-6.py-4.text-left Name
            th.px-6.py-4.text-left Status
            th.px-6.py-4.text-left Actions

        tbody
          each dept in departs
            tr(class="border-b border-gray-700 hover:bg-gray-700 transition")
              td.px-6.py-4 #{dept._id}
              td.px-6.py-4.font-medium #{dept.name}
              td.px-6.py-4
                if dept.hidden
                  span.text-red-400 Hidden
                else
                  span.text-green-400 Visible
              td.px-6.py-4
                a(
                  href=`/view/department/${dept._id}`
                  class="text-blue-400 hover:underline"
                ) View
