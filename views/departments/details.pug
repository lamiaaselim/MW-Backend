doctype html
html
  head
    title= title
    script(src="https://cdn.tailwindcss.com")
  body.bg-gray-200.min-h-screen.p-6

    // Header
    .max-w-3xl.mx-auto.mb-6.flex.items-center.justify-between
      h1.text-2xl.font-bold Department Details
      a(
        href="/view/department"
        class="text-blue-600 hover:underline"
      ) ← Back

    // Card
    .max-w-3xl.mx-auto.bg-white.rounded-lg.shadow-md.p-6
      div(class="grid grid-cols-1 md:grid-cols-2 gap-6")

        // ID
        .flex.flex-col
          span.text-sm.text-gray-500 Department ID
          span.text-lg.font-semibold #{depart._id}

        // Name
        .flex.flex-col
          span.text-sm.text-gray-500 Department Name
          span.text-lg.font-semibold #{depart.name}

        // Status
        .flex.flex-col
          span.text-sm.text-gray-500 Status
          if depart.hidden
            span(
              class="inline-block w-fit px-3 py-1 rounded-full text-sm bg-red-100 text-red-600"
            ) Hidden
          else
            span(
              class="inline-block w-fit px-3 py-1 rounded-full text-sm bg-green-100 text-green-600"
            ) Visible

    // Actions
    .max-w-3xl.mx-auto.mt-6.flex.gap-4
      a(
        href=`/view/department/edit/${depart._id}`
        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition"
      ) Edit
      a(
        href="/view/department"
        class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition"
      ) Back to List
